# ── Supabase ─────────────────────────────────────────────
# Base project URL, WITHOUT a trailing /rest/v1/  (e.g. https://xxxx.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co
# The SERVICE ROLE key (a long JWT, NOT the project URL, NOT the anon key).
# Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVC...

# ── Telegram ─────────────────────────────────────────────
# Bot token from @BotFather. Used to verify Mini App initData signatures.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# ── Encryption ───────────────────────────────────────────
# Fernet key used to encrypt messenger sessions at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=generate-a-fernet-key-here

# ── App behaviour (optional) ─────────────────────────────
# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Allow the local-dev Telegram initData bypass (never enable in production).
ALLOW_DEV_LOGIN=true
# Background poller that pulls new incoming messages into the DB.
ENABLE_POLLER=true
POLL_INTERVAL_SECONDS=45
